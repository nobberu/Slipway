import { ListView } from "std-widgets.slint";

export struct ResultItem {
    title: string,
    subtitle: string,
    kind: string,
    initial: string,
    is-header: bool,
}

export component AppWindow inherits Window {
    title: "Slipway";
    no-frame: true;
    always-on-top: true;
    width: 750px;
    height: 475px;
    background: transparent;

    in-out property <string> query;
    in-out property <[ResultItem]> results;
    in-out property <int> selected: 0;

    callback query-changed(string);
    callback activate(int);

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        border-width: 1px;
        border-color: #ffffff2f;
        border-radius: 8px;

        WindowMoveArea {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 65px;
        }

        Image {
            x: 16px;
            y: 22px;
            width: 21px;
            height: 21px;
            source: @image-url("assets/Logo-transparent.png");
        }

        input := TextInput {
            x: 48px;
            y: 0px;
            width: parent.width - 64px;
            height: 65px;
            font-size: 17px;
            color: #f2f5f7;
            single-line: true;
            vertical-alignment: center;
            text <=> root.query;

            edited => {
                root.query-changed(self.text);
            }
        }

        Text {
            x: 48px;
            y: 0px;
            width: parent.width - 64px;
            height: 65px;
            text: "Search for apps or commands…";
            font-size: 19px;
            color: #ffffff59;
            vertical-alignment: center;
            visible: root.query == "";
        }

        Rectangle {
            y: 65px;
            width: 100%;
            height: 1px;
            background: #ffffff2f;
        }

        ListView {
            x: 0px;
            y: 66px;
            width: parent.width;
            height: parent.height - 66px - 42px;

            for item[i] in root.results: Rectangle {
                height: item.is-header ? 32px : 40px;

                if item.is-header: Text {
                    x: 16px;
                    height: parent.height - 12px;
                    text: item.title;
                    font-size: 11px;
                    font-weight: 800;
                    color: #ffffff66;
                    vertical-alignment: bottom;
                }

                if !item.is-header: Rectangle {
                    y: 1px;
                    x: 8px;
                    width: parent.width - 16px;
                    height: 37px;
                    border-radius: 5px;
                    background: root.selected == i ? #ffffff1f : transparent;

                    TouchArea {
                        clicked => {
                            root.selected = i;
                            root.activate(i);
                        }
                    }

                    Rectangle {
                        x: 8px;
                        y: 7px;
                        width: 22px;
                        height: 22px;
                        background: #ec004a;
                        border-radius: 4px;

                        Text {
                            text: item.initial;
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    HorizontalLayout {
                        x: 42px;
                        width: parent.width - 42px - 150px;
                        height: parent.height;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: item.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: #f2f5f7;
                            vertical-alignment: center;
                        }

                        Text {
                            text: item.subtitle;
                            font-size: 13px;
                            color: #ffffff73;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        x: parent.width - 150px;
                        width: 136px;
                        height: parent.height;
                        text: item.kind;
                        font-size: 13px;
                        color: #ffffff73;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            y: parent.height - 42px;
            width: 100%;
            height: 1px;
            background: #ffffff2f;
        }
    }
}
